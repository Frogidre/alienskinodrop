# Alien Mod - Simple Voice Chat Integration Configuration

# This file documents how the voice chat mouth animation works:
#
# 1. AlienPlayerRenderer checks each render frame whether a player is speaking
#    via Simple Voice Chat's VoiceChatPlayer API
# 2. When speaking is true, the model matrix rotates around the X axis
#    to simulate mouth opening/closing
# 3. The jaw opens and closes rhythmically while speaking
# 4. When not speaking, the mouth stays closed
#
# Required mods:
# - fabric-api (0.141.3+1.21.11)
# - simplevoicechat (any version supporting 1.21.11)

voice_chat_enabled=true
jaw_animation_speed=15
max_jaw_open=0.4
